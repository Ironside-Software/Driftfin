<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Jellyfin.Plugin.Driftfin</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Driftfin</AssemblyName>
    <!-- Keep in sync with build.yaml; CI validates the version and target ABI. -->
    <Version>2.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Target the Jellyfin server ABI you run; align with build.yaml's targetAbi. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

</Project>
